    ],
    "reviewArgs": [
      "--approval-mode",
      "plan"
    ],
    "writeArgs": [
      "--approval-mode",
      "auto-edit"
    ],
    "resumeExtraArgs": [
      "--resume",
      "{session}"
    ],
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "effortArgs": [],
    "schemaArgs": [],
    "finalMessageArgs": [],
    "budgetArgs": [],
    "promptArgs": []
  }
}
