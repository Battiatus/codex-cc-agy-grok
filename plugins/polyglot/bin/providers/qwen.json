{
  "schemaVersion": 2,
  "id": "qwen",
  "displayName": "Qwen Code Connector",
  "binary": "qwen",
  "resultAdapter": "qwen",
  "versionArgs": [
    "--version"
  ],
  "helpProbes": [
    [
      "--help"
    ]
  ],
  "knownHiddenFlags": [],
  "authProbe": null,
  "installHint": "Install Qwen Code CLI",
  "effortValues": [
    "low",
    "medium",
    "high"
  ],
  "capabilities": {
